# Application
APP_BASE_URL=http://localhost:3000
APP_SECRET=replace-with-local-random-secret
APP_ACCESS_PASSCODE=replace-with-local-passcode
DEFAULT_USER_ID=replace-with-seeded-user-id
NODE_ENV=development

# Database
# Postgres is expected to run in Docker locally and on Synology/Linux.
DATABASE_URL=postgresql://phip:replace-with-password@localhost:5432/phip?schema=public
POSTGRES_DB=phip
POSTGRES_USER=phip
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=./docker-data/postgres

# AI
# Provide a real key only when AI-backed generation begins.
AI_PROVIDER=fake
AI_API_KEY=

# Jobs
JOB_WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=3
JOB_POLL_INTERVAL_MS=5000

# Backups
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups/postgres

# Logging
LOG_LEVEL=info
